# Copy this file to .env and fill in real values. Never commit .env.

PORT=5000

# MongoDB Atlas connection string (or any reachable MongoDB instance).
# If left unset, the server falls back to an in-memory MongoDB for local
# development only -- data will not persist between restarts.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/digital_vault?retryWrites=true&w=majority

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=30d

# Comma-separated list of allowed origins for CORS. Leave unset to allow all
# (fine for local development with a mobile app that has no browser origin).
FRONTEND_URL=
