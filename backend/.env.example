# Copy this file to .env and fill in real values. Never commit .env.

PORT=5000

# MongoDB Atlas connection string (or any reachable MongoDB instance).
# If left unset, the server falls back to a local throwaway MongoDB for
# development only -- data will not persist between restarts.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/digital_vault?retryWrites=true&w=majority

# Firebase service-account key (Firebase console -> Project settings ->
# Service accounts -> Generate new private key). Secret: never commit it.
# Relative paths resolve against backend/.
FIREBASE_CREDENTIALS=firebase-service-account.json

# Comma-separated list of allowed origins for CORS. Leave unset to allow all
# (fine for local development with a mobile app that has no browser origin).
FRONTEND_URL=
